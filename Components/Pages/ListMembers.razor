@page "/listMembers"
@inject DbServices dbServices
@inject ILogger<ListMembers> logger

@rendermode InteractiveServer

<h3>List of familly members</h3>

@if (FamillyMembers.Count != 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <td>#</td>
                <td>Name</td>
                <td>Surname</td>
                <td>Dates</td>
                <td>Action</td>
            </tr>
        </thead>
        <tbody>
            @foreach (var person in FamillyMembers)
            {
                var birthDate = @person.Birthdate.ToString("dd-MM-yyyy");
                var dateOfDeath = @person.DateOfDeath == DateTime.MinValue ? "*" : person.DateOfDeath.ToString("dd-MM-yyyy");
                <tr>
                    <th></th>
                    <th>@person.Name</th>
                    <th>@person.Surname</th>
                    <th>@birthDate - @dateOfDeath</th>
                    <th><button class="btn btn-danger" @onclick="(args) => DeletePerson(args, person.ID)">Delete</button></th>
                </tr>

            }
        </tbody>
    </table>
}
else
{
    <div class="bg-info">Loading ... </div>
}


@code {


    private List<Person> FamillyMembers { get; set; } = new List<Person>();


    protected override Task OnInitializedAsync()
    {
        FamillyMembers = dbServices.GetPeople().ToList();
        return base.OnInitializedAsync();
    }


    private async void DeletePerson(MouseEventArgs args, Guid id)
    {
        var personToDelete = FamillyMembers.Find(x => x.ID == id);
        if (personToDelete != null)
        {
            var res = await dbServices.DeletePerson(id);
            if (res == true)
            {
                logger.LogInformation($"Person '{personToDelete.Name}' removed!");
                FamillyMembers.Remove(personToDelete);
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                logger.LogWarning($"Error removing person '{personToDelete.Name}'");
            }


        }
    }
}
