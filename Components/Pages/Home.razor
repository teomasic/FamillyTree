@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager navigation
@inject DbServices dbServices

<PageTitle>Familly Tree App</PageTitle>

<div id="scene_div" class="m-0 p-0" style="width:100%; height: 700px;"></div>

@code {
    public List<Person> People { get; set; } = new List<Person>();

    public Lazy<Task<IJSObjectReference>> homeJs_moduleTask = new ();

    protected async override Task OnInitializedAsync()
    {

        await LoadPeople();
        await base.OnInitializedAsync();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotnetRef = DotNetObjectReference.Create(this);

            homeJs_moduleTask = new(() => JS.InvokeAsync<IJSObjectReference>("import", "./home.js").AsTask());
            var homeJs = await homeJs_moduleTask.Value;
            var res = await homeJs.InvokeAsync<bool>("Init", dotnetRef);
            if (res)
            {
                _ = homeJs.InvokeAsync<bool>("InitFamillyMembers", People);
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // ################################## PRIVATE #################

    private async Task LoadPeople()
    {
        var people = this.dbServices.GetPeople();
        if (people.Count == 0)
        {
            var testPerson = new Person()
                {
                    Name = "Tadej",
                    Surname = "Mašić",
                    BirthPlace = "Brežice",
                    Birthdate = new DateTime(1993, 2, 7),
                    LocationX = 10,
                    LocationY = 10,
                    Profession = "Software Engineer"
                };

            People = new List<Person>();
            People.Add(testPerson);
            dbServices.AddPerson(testPerson);
        }
        else
        {
            People = people.ToList();
        }

        await Task.CompletedTask;
    }

    private Task AddNewPerson()
    {
        navigation.NavigateTo("/addPerson");

        return Task.CompletedTask;
    }
}