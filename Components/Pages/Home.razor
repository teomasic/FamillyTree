@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager navigation

<PageTitle>Familly Tree App</PageTitle>

<div id="scene_div" style="width:100%; height: 300px;"></div>

@code {

    [Inject]
    public DbServices dbServices { get; set; }

    public List<Person> People { get; set; }

    public Home()
    {
        People = new List<Person>();
    }

    // private IJSObjectReference? homeJsModule;
    public Lazy<Task<IJSObjectReference>> homeJs_moduleTask;

    protected async override Task OnInitializedAsync()
    {
        await LoadPeople();
        await base.OnInitializedAsync();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            homeJs_moduleTask = new(() => JS.InvokeAsync<IJSObjectReference>("import", "./home.js").AsTask());
            var homeJs = await homeJs_moduleTask.Value;
            _ = homeJs.InvokeVoidAsync("Init");
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // ################################## PRIVATE #################

    private async Task LoadPeople()
    {
        var people = this.dbServices.GetPeople();
        if (people.Count == 0)
        {
            var testPerson = new Person()
                {
                    Name = "Tadej",
                    Surname = "Mašić",
                    BirthPlace = "Brežice",
                    Birthdate = new DateTime(1993, 2, 7),
                    LocationX = 500,
                    LocationY = 500,
                    Profession = "Software Engineer"
                };

            People = new List<Person>();
            People.Add(testPerson);
            dbServices.AddPerson(testPerson);
        }
        else
        {
            People = people.ToList();
        }
    }

    private Task AddNewPerson()
    {
        navigation.NavigateTo("/addPerson");

        return Task.CompletedTask;
    }
}