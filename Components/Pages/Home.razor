@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager navigation
@inject DbServices dbServices
@inject ILogger<Home> logger

<PageTitle>Familly Tree App</PageTitle>

<div id="scene_div" class="m-0 p-0" style="width:100%; height: 700px;"></div>

@code {
    public List<Person> FamillyMembers { get; set; } = new List<Person>();

    public Lazy<Task<IJSObjectReference>> homeJs_moduleTask = new();

    protected async override Task OnInitializedAsync()
    {

        await LoadPeople();
        await base.OnInitializedAsync();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotnetRef = DotNetObjectReference.Create(this);

            homeJs_moduleTask = new(() => JS.InvokeAsync<IJSObjectReference>("import", "./home.js").AsTask());
            var homeJs = await homeJs_moduleTask.Value;
            var res = await homeJs.InvokeAsync<bool>("Init", dotnetRef);
            if (res)
            {
                _ = homeJs.InvokeAsync<bool>("InitFamillyMembers", FamillyMembers);
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    // ################################## PRIVATE #################

    private async Task LoadPeople()
    {
        var people = this.dbServices.GetPeople();
        if (people.Count == 0)
        {
            var testPerson = new Person()
                {
                    Name = "Tadej",
                    Surname = "Mašić",
                    BirthPlace = "Brežice",
                    Birthdate = new DateTime(1993, 2, 7),
                    LocationX = 10,
                    LocationY = 10,
                    Profession = "Software Engineer"
                };

            FamillyMembers = new List<Person>();
            FamillyMembers.Add(testPerson);
            dbServices.AddPerson(testPerson);
        }
        else
        {
            FamillyMembers = people.ToList();
        }

        await Task.CompletedTask;
    }

    private Task AddNewPerson()
    {
        navigation.NavigateTo("/addPerson");

        return Task.CompletedTask;
    }


    // ################################## PUBLIC #################
    [JSInvokable]
    public async void SaveNewMembersCoords(string id, int x, int y)
    {
        var parseResult = Guid.TryParse(id, out Guid guid);
        if (parseResult == true)
        {
            var member = FamillyMembers.Find(x => x.ID == guid);
            if (member != null)
            {
                member.LocationX = x;
                member.LocationY = y;
                await dbServices.UpdatePerson(member);
            }
        }
        else{
            logger.LogError($"Error updating member's new position. Could not parse member id '{id}'");
        }
        await Task.CompletedTask;
    }
}